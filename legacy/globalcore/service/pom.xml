<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.3.5</version>
    <relativePath/>
  </parent>

  <groupId>com.andrelair.globalcore</groupId>
  <artifactId>globalcore-legacy</artifactId>
  <version>0.1.0</version>
  <name>GlobalCore Legacy (simulated)</name>
  <description>Simulated legacy claims core: SOAP facade over MySQL, wrapped by the ktayl-claims ACL.</description>

  <properties>
    <java.version>21</java.version>
    <!-- Override Spring Boot 3.3.5's managed Tomcat (10.1.31) → patched 10.1.60 (matches the ACL pom):
         clears the CRITICAL tomcat CVEs (FORM-auth bypass CVE-2026-68525 et al.) the scan-before-push caught. -->
    <tomcat.version>10.1.60</tomcat.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web-services</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <dependency>
      <groupId>com.mysql</groupId>
      <artifactId>mysql-connector-j</artifactId>
      <scope>runtime</scope>
    </dependency>
    <!-- WSDL generation for Spring-WS DefaultWsdl11Definition -->
    <dependency>
      <groupId>wsdl4j</groupId>
      <artifactId>wsdl4j</artifactId>
    </dependency>
    <!-- JAXB runtime for the XSD-generated message classes (Jakarta) -->
    <dependency>
      <groupId>org.glassfish.jaxb</groupId>
      <artifactId>jaxb-runtime</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
      <!-- Contract-first: generate JAXB message classes from the XSD (Jakarta XJC via jaxb2 3.x) -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>jaxb2-maven-plugin</artifactId>
        <version>3.2.0</version>
        <executions>
          <execution>
            <id>xjc</id>
            <goals><goal>xjc</goal></goals>
          </execution>
        </executions>
        <configuration>
          <sources>
            <source>src/main/resources/xsd/globalcore.xsd</source>
          </sources>
          <packageName>com.andrelair.globalcore.gen</packageName>
          <clearOutputDir>false</clearOutputDir>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
