<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.3.5</version>
    <relativePath/>
  </parent>

  <groupId>com.andrelair.ktayl</groupId>
  <artifactId>claims-acl</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <name>ktayl-claims-acl</name>
  <description>Modern Claims capability built AS the ACL / strangler over the GlobalCore legacy (ADR-001/006)</description>

  <properties>
    <java.version>21</java.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- Override the Spring-Boot-managed embedded Tomcat to clear 7 CRITICAL CVEs
         (CVE-2025-24813 + 2026 tomcat-coyote advisories) flagged by the CI Trivy gate. -->
    <tomcat.version>10.1.60</tomcat.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>

    <!-- Slice B (ADR-006): SOAP client to the live GlobalCore legacy. spring-ws WebServiceTemplate +
         a Jaxb2Marshaller over the client stubs generated from the SAME globalcore.xsd. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web-services</artifactId>
    </dependency>
    <dependency>
      <groupId>org.glassfish.jaxb</groupId>
      <artifactId>jaxb-runtime</artifactId>
    </dependency>

    <!-- Slice D (ADR-008): CQRS read-model. JPA + PostgreSQL (CNPG) for the query side; Flyway owns the
         read-model schema; jnats is the JetStream consumer that projects the Slice-C CDC feed into it. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
    </dependency>
    <dependency>
      <groupId>io.nats</groupId>
      <artifactId>jnats</artifactId>
      <version>2.20.5</version>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- L2 integration: a throwaway Postgres for the read-model repo/projector tests. -->
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
      <!-- Generate the SOAP client stubs from the shared globalcore.xsd (into ...legacy.gen). -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>jaxb2-maven-plugin</artifactId>
        <version>3.2.0</version>
        <executions>
          <execution>
            <id>xjc</id>
            <goals><goal>xjc</goal></goals>
          </execution>
        </executions>
        <configuration>
          <sources><source>src/main/resources/xsd/globalcore.xsd</source></sources>
          <packageName>com.andrelair.ktayl.claims.legacy.gen</packageName>
          <clearOutputDir>false</clearOutputDir>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <!-- Allow Mockito/Byte Buddy to run on a JDK newer than it officially supports
               (local dev may be on JDK 24+; CI pins Java 21 where this is a no-op). -->
          <argLine>-Dnet.bytebuddy.experimental=true</argLine>
          <!-- surefire runs L0/L1 unit tests (*Test); the L2 *IT integration tests are run by
               failsafe in the integration-test phase (they need Docker/testcontainers). -->
          <excludes>
            <exclude>**/*IT.java</exclude>
          </excludes>
        </configuration>
      </plugin>
      <!-- L2 integration tests (*IT) — testcontainers Postgres. Bound to verify so `mvn verify`
           (the CI gate) runs them; GitHub runners have Docker. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <configuration>
          <argLine>-Dnet.bytebuddy.experimental=true</argLine>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
