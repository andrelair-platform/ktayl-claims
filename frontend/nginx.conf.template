# BFF shim (ADR-009): nginx serves the Angular SPA AND reverse-proxies /api → the internal ACL Service,
# so the browser talks same-origin here and the ACL API is never exposed to the public surface.
# ${API_URL} is substituted at container start (nginx /etc/nginx/templates envsubst) from the API_URL env
# → one env-agnostic image (dev + prod point at the in-cluster ACL Service). nginx vars use $x (no braces).
server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # own health (does NOT touch the ACL — the SPA's liveness is independent of the API)
    location = /healthz {
        access_log off;
        add_header Content-Type text/plain;
        return 200 'ok';
    }

    # BFF: proxy API calls server-side to the internal ACL (no URI part on proxy_pass → full path passes through)
    location /api/ {
        proxy_pass ${API_URL};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # SPA routing — fall back to index.html for client-side routes
    location / {
        try_files $uri $uri/ /index.html;
    }
}
